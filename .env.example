# ==============================================================================
# GAMIFIED LEARNING PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULE:
# NEVER commit `.env.local` or any file containing real keys to Git.
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Service Role Key (Server-side only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Demo Mode (Quick role-switcher for dev/testing, set to 'false' by default)
NEXT_PUBLIC_DEMO_MODE="false"

# Application Timezone (Fixed to Indian Standard Time)
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# Direct Postgres Connection URI (Local .env.local only, NEVER in hosting/Vercel env)
# Used for terminal database migrations via npm run migrate
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Cron Secret for Vercel Cron and automated rollover endpoints (local only / configure in deployment env)
CRON_SECRET="your-cron-secret-token"

